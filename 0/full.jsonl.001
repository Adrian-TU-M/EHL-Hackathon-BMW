[params] = useSearchParams();\\n  return params.get(\\\"demo\\\") === \\\"1\\\" ? (\\n    <DemoCouncil />\\n  ) : params.has(\\\"source_run\\\") ? (\\n    <LiveCouncil />\\n  ) : params.get(\\\"advanced\\\") === \\\"1\\\" ? (\\n    <ModeratorCouncil />\\n  ) : (\\n    <VehicleCouncil />\\n  );\\n}\\nfunction DemoCouncil() {\\n19:export interface FeatureAssessment {\\n47:  features: FeatureAssessment[];\\n  assessment: JudgeAssessment | null;\\n  decisions?: {\\n    feature_id: string;\\n    version: number;\\n    action: string;\\n    rationale: string;\\n    assessment_id: string;\\n    timestamp: string;\\n  }[];\\n  request: {\\n    background?: string;\\n    scope: {\\n      vehicle: string;\\n      market: string;\\n      powertrain: string;\\n      horizon: number;\\n      prompt: string;\\n    };\\n    features: {\\n      id: string;\\n      version: number;\\n      title: string;\\n      description: string;\\n      topic: string;\\n    }[];\\n    arguments: {\\n      id: string;\\n      agent: string;\\n      feature_ids: string[];\\n      statement: string;\\n      evidence_ids: string[];\\n      assumptions: string[];\\n    }[];\\n    evidence: {\\n      id: string;\\n      source: string;\\n      location: string;\\n      passage: string;\\n      provenance: string;\\n  run,\\n  agentId,\\n  messages,\\n  onMessage: recordCouncilMessage,\\n  clientTools,\\n  localTransport,\\n  reviewHref,\\n}: {\\n  context: string;\\n  run: string | number;\\n  agentId: string;\\n  messages: JudgeMessage[];\\n  onMessage: (message: JudgeMessage) => void;\\n  clientTools?: ClientTools;\\n  localTransport?: LocalJudgeTransport;\\n  reviewHref?: string;\\n}) {\\n  const [thread, setThread] = useState(() => savedConversationThread(run));\\n  const threadRef = useRef(thread);\\n  const connectionId = useRef(crypto.randomUUID());\\n  const visibleMessages = conversationMessages(messages, thread);\\n  const [voiceOpen, setVoiceOpen] = useState(false);\\n  const dialogRef = useRef<HTMLDialogElement>(null);\\n  const transcriptRef = useRef<HTMLDivElement>(null);\\n  const [channel, setChannel] = useState<\\\"text\\\" | \\\"voice\\\">(\\\"voice\\\");\\n  const [input, setInput] = useState(\\\"\\\");\\n  const [error, setError] = useState(\\\"\\\");\\n  const [inputLevel, setInputLevel] = useState(0);\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a12915-f14a-7292-888b-5b2b4a685e60","create_time":1791690867.884441}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}

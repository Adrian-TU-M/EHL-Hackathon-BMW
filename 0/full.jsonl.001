str] = Field(default_factory=list)\\n    uncertainties: list[str] = Field(default_factory=list)\\n    alternatives: list[str] = Field(default_factory=list)\\n    proposed_description: str | None = None\\n    consequential_uncertainty: bool = False\\n\\n\\nclass PriorityProposal(Model):\\n    weights: Weights\\n    constraints: list[str] = Field(default_factory=list)\\n    rationale: Text\\n\\n\\nclass DraftAssessment(Model):\\n    arguments: list[ArgumentAssessment]\\n    features: list[FeatureAssessment]\\n    clarification_requests: list[str] = Field(default_factory=list)\\n    proposed_priorities: PriorityProposal | None = None\\n\\n\\nclass JudgeAssessment(DraftAssessment):\\n    id: str\\n    created_at: str\\n    weights: Weights\\n    constraints: list[str]\\n    ranked_feature_ids: list[str]\\n    next_action: Literal[\\\"continue\\\", \\\"request_clarification\\\", \\\"pause_for_pm\\\"]\\n    execution: Literal[\\\"live\\\", \\\"demo\\\"]\\n    input_digest: str\\n    model: str | None = None\\n    provider: str | None = None\\n\\n\\nclass CouncilEvent(Model):\\n    sequence: int\\n    id: str\\n    stage: Stage\\n    actor: Literal[\\\"customer\\\", \\\"market\\\", \\\"competitor\\\", \\\"moderator\\\", \\\"judge\\\", \\\"PM\\\"]\\n    statement: Text\\n    evidence_ids: list[str] = Field(default_factory=list)\\n    timestamp: str\\n\\n\\nclass StageResult(Model):\\n    \\\"\\\"\\\"Returned by the teammate moderator; retrieval occurs outside the Judge.\\\"\\\"\\\"\\n\\\"\\\"\\\"Minimal Ollama client: /api/chat with JSON-schema constrained output.\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport json\\nfrom typing import Any\\n\\nimport httpx\\n\\nfrom .config import Settings\\n\\n\\nclass LLMUnavailable(RuntimeError):\\n    \\\"\\\"\\\"Ollama is not reachable, the model is missing, or the call timed out.\\\"\\\"\\\"\\n\\n\\nclass LLMOutputError(RuntimeError):\\n    \\\"\\\"\\\"The model returned output that does not parse as the requested JSON.\\\"\\\"\\\"\\n\\n\\nclass OllamaClient:\\n    def __init__(self, settings: Settings):\\n        self.base_url = settings.ollama_base_url.rstrip(\\\"/\\\")\\n        self.model = settings.ollama_model\\n        self.timeout = settings.ollama_timeout_s\\n        self.max_tokens = settings.max_output_tokens\\n\\n    def status(self) -> dict[str, Any]:\\n        try:\\n            response = httpx.get(f\\\"{self.base_url}/api/tags\\\", timeout=5)\\n            response.raise_for_status()\\n        except httpx.HTTPError as exc:\\n            return {\\\"reachable\\\": False, \\\"model\\\": self.model, \\\"modelAvailable\\\": False, \\\"error\\\": str(exc)}\\n        names = {m[\\\"name\\\"] for m in response.json().get(\\\"models\\\", [])}\\n        return {\\\"reachable\\\": True, \\\"model\\\": self.model, \\\"modelAvailable\\\": self.model in names}\\n\\n    def chat_json(self, system: str, user: str, schema: dict, temperature: float = 0.2) -> dict:\\n        \\\"\\\"\\\"One retry on unparseable output (e.g. a generation cut off by the token cap).\\\"\\\"\\\"\\n        try:\\n            return self._chat_json(system, user, schema, temperature, seed=7)\\n        except LLMOutputError:\\n            return self._chat_json(system, user, schema, temperature, seed=8)\\n\\n    def _chat_json(self, system: str, user: str, schema: dict, temperature: float, seed: int) -> dict:\\n        payload = {\\n            \\\"model\\\": self.model,\\n            \\\"stream\\\": False,\\n            \\\"think\\\": False,  # qwen3: skip the reasoning trace; schema output only\\n            \\\"format\\\": schema,\\n            \\\"messages\\\": [{\\\"role\\\": \\\"system\\\", \\\"content\\\": system}, {\\\"role\\\": \\\"user\\\", \\\"content\\\": user}],\\n            \\\"options\\\": {\\n                \\\"temperature\\\": temperature,\\n                \\\"seed\\\": seed,\\n                \\\"num_predict\\\": self.max_tokens,\\n                \\\"num_ctx\\\": 16384,\\n            …83 tokens truncated… raise LLMUnavailable(f\\\"Model {self.model!r} not found. Run: ollama pull {self.model}\\\")\\n        if response.status_code >= 400:\\n            raise LLMUnavailable(f\\\"Ollama error {response.status_code}: {response.text[:300]}\\\")\\n        result = response.json()\\n        from backend.llm.usage import record_usage\\n        record_usage(result)\\n        content = result.get(\\\"message\\\", {}).get(\\\"content\\\", \\\"\\\")\\n        try:\\n            return json.loads(content)\\n        except json.JSONDecodeError as exc:\\n            raise LLMOutputError(f\\\"Model output is not valid JSON: {content[:300]}\\\") from exc\\nactual arguments 17 source count 9 request chars 31408 schema chars 26576\\n41:            issues.append(\\\"G60/G68 aggregation must remain explicit\\\")\\n            claim.statement,\\n            re.I,\\n        ):\\n            issues.append(\\\"Mean rating scale is undocumented\\\")\\n        if e.region == \\\"Germany\\\" and not re.search(\\n            r\\\"german|germany|deutsch\\\", claim.statement, re.I\\n        ):\\n            issues.append(\\\"German equipment applicability must remain explicit\\\")\\n        if (\\n            e.context_type\\n            in {\\\"management_expectation\\\", \\\"corporate_target\\\", \\\"model_announcement\\\"}\\n            and claim.kind == \\\"observation\\\"\\n        ):\\n            issues.append(\\n                \\\"Expectations, targets and announcements cannot become reported results\\\"\\n            )\\n    if (\\n        any(e.kind == \\\"equipment\\\" and not e.equipment_verified for e in refs)\\n        and claim.kind == \\\"observation\\\"\\n    ):\\n        issues.append(\\n            \\\"Equipment availability/status is not verified from PDF table columns\\\"\\n        )\\n    calc = claim.calculation\\n    if calc:\\n        calc_refs = [\\n            evidence[i] for i in calc.evidence_ids if i in evidence and i in allowed_ids\\n        ]\\n        if len(calc_refs) != len(calc.evidence_ids) or not set(\\n            calc.evidence_ids\\n        ).issubset(claim.evidence_ids):\\n            issues.append(\\\"Calculation references must be valid claim references\\\")\\n        if any(not applicable(e, scope, True) or e.excluded_reason for e in calc_refs):\\n            issues.append(\\\"Calculation includes excluded or out-of-scope evidence\\\")\\n        source_values = [\\n            e.quantitative.get(\\\"value\\\")\\n            for e in calc_refs\\n            if e.quantitative and isinstance(e.quantitative.get(\\\"value\\\"), (int, float))\\n        ]\\n        if len(source_values) != len(calc.values) or sorted(source_values) != sorted(\\n            calc.values\\n        ):\\n            issues.append(\\n                \\\"Calculation operands must match cited scalar values; distributions/feedback need an explicit derived dataset\\\"\\n            )\\n        if any(\\n            e.quantitative and e.quantitative.get(\\\"unit\\\") != calc.unit\\n            for e in calc_refs\\n        ):\\n            issues.append(\\\"Calculation units differ from source units\\\")\\n        if any(e.kind in {\\\"study_mean\\\", \\\"study_distribution\\\"} for e in calc_refs):\\n            issues.append(\\n                \\\"Undocumented scales and unknown sample counts cannot be pooled or used as respondent denominators\\\"\\n            )\\n        if len({e.kind for e in calc_refs}) > 1:\\n            issues.append(\\\"Actual and future populations must not be pooled\\\")\\n        if (\\n            len({e.region for e in calc_refs}) > 1\\n            or len({e.vehicle for e in calc_refs}) > 1\\n        ):\\n            issues.append(\\n                \\\"Mixed populations require a separately reviewed derived dataset\\\"\\n            )\\n        if any(e.period and e.period not in calc.period for e in calc_refs):\\n            issues.append(\\\"Calculation must identify every source period\\\")\\n        expected = None\\n        if calc.operation == \\\"sum\\\":\\n            expected = sum(calc.values)\\n        elif calc.operation == \\\"mean\\\":\\n            expected = sum(calc.values) / len(calc.values)\\n        elif (\\n            calc.operation == \\\"growth\\\" and len(calc.values) == 2 and calc.values[0] != 0\\n        ):\\n            expected = (calc.values[1] - calc.values[0]) / calc.values[0]\\n        elif calc.operation == \\\"share\\\" and calc.denominator and calc.denominator > 0:\\n            # Denominators must themselves be a cited operand; no invented n.\\n            if calc.denominator not in source_values:\\n                issues.append(\\\"Unsupported denominator\\\")\\n            expected = calc.values[0] / calc.denominator\\n        if (\\n            expected is None\\n            or not math.isfinite(calc.result)\\n            or not math.isclose(expected, calc.result, rel_tol=1e-6, abs_tol=1e-9)\\n        ):\\n            issues.append(\\\"Invalid arithmetic or zero/unknown denominator\\\")\\n    claim.issues = issues\\n    claim.validation = \\\"unsupported\\\" if issues else \\\"unverified\\\"\\n    claim.semantic_check = \\\"pending\\\" if not issues else \\\"deterministic_rejection\\\"\\n    return claim\\n\\n\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a12915-f14a-7292-888b-5b2b4a685e60","create_time":1791692822.134796}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}

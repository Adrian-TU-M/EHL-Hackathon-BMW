;\\n    description…65 tokens truncated… string;\\n  version: number;\\n  brief: {\\n    topic_id: string;\\n    question: string;\\n    scope: Scope;\\n    limitations: string[];\\nimport type { CSSProperties } from \\\"react\\\";\\nimport \\\"../../styles/jury-avatar.css\\\";\\n\\nconst expressions = {\\n  affectionate: { emoji: \\\"💙\\\", label: \\\"Appreciative\\\" },\\n  confident: { emoji: \\\"✨\\\", label: \\\"Confident\\\" },\\n  calm: { emoji: \\\"😌\\\", label: \\\"Ready\\\" },\\n  curious: { emoji: \\\"👂\\\", label: \\\"Listening\\\" },\\n  thoughtful: { emoji: \\\"🤔\\\", label: \\\"Considering\\\" },\\n  warm: { emoji: \\\"😊\\\", label: \\\"Encouraging\\\" },\\n  excited: { emoji: \\\"✨\\\", label: \\\"Inspired\\\" },\\n  concerned: { emoji: \\\"🧐\\\", label: \\\"Looking closer\\\" },\\n  surprised: { emoji: \\\"💡\\\", label: \\\"New perspective\\\" },\\n  reassuring: { emoji: \\\"💙\\\", label: \\\"Reassuring\\\" },\\n  engaged: { emoji: \\\"💬\\\", label: \\\"Explaining\\\" },\\n} as const;\\ntype Expression = keyof typeof expressions;\\n\\n// Explicit delivery tags take priority; keyword cues are only visual hints.\\nfunction replyExpression(text: string): Expression {\\n  const tag = text.match(/\\\\[([^\\\\]]+)\\\\]/)?.[1] || \\\"\\\";\\n  const classify = (value: string): Expression | undefined => {\\n    if (\\n      /\\\\b(love|lovely|grateful|affectionate|appreciate|thank you|kind words)\\\\b/i.test(\\n        value,\\n      )\\n    )\\n      return \\\"affectionate\\\";\\n    if (\\n      /\\\\b(confident|cool|awesome|absolutely|great job|well done|nailed it)\\\\b/i.test(\\n        value,\\n      )\\n    )\\n      return \\\"confident\\\";\\n    if (/\\\\b(excited|enthusiastic|delighted|inspired)\\\\b/i.test(value))\\n  );\\n  const agentId =\\n    voiceSession?.agent_id || import.meta.env.VITE_ELEVENLABS_AGENT_ID?.trim();\\n  return (\\n    <section\\n      className=\\\"jury-live-handoff\\\"\\n      aria-label=\\\"Discuss the actual Judge verdict\\\"\\n    >\\n      <header className=\\\"jury-live-heading\\\">\\n        <span className=\\\"eyebrow\\\">JURY / SAVED VERDICT</span>\\n        <h2>Discuss with the Judge</h2>\\n        <p>\\n          {assessment.features[0]?.rationale || outcome.assessment?.summary}\\n        </p>\\n      </header>\\n      {voiceSession && !localText ? (\\n        <ConversationProvider key={`${sessionId}:${assessment.id}`}>\\n    scope: Scope\\n    background: Annotated[str, Field(max_length=20000)] = \\\"\\\"\\n    external_processing_approved: bool = False\\n    features: Annotated[list[Feature], Field(min_length=1, max_length=100)]\\n    arguments: Annotated[list[Argument], Field(max_length=500)]\\n    evidence: Annotated[list[Evidence], Field(max_length=1000)]\\n    weights: Weights = Field(default_factory=Weights)\\n    constraints: list[str] = Field(default_factory=list)\\n    pm_message: str | None = None\\n    clarification_used: bool = False\\n\\n    @model_validator(mode=\\\"after\\\")\\n    def check_lineage(self):\\n        for items in (self.features, self.arguments, self.evidence):\\n            ids = [item.id for item in items]\\n            if len(ids) != len(set(ids)):\\n                raise ValueError(\\\"IDs must be unique within each collection\\\")\\n        features = {f.id for f in self.features}\\n        for arg in self.arguments:\\n            if not set(arg.feature_ids) <= features:\\n                raise ValueError(\\\"Argument refers to an unknown feature\\\")\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a12915-f14a-7292-888b-5b2b4a685e60","create_time":1791690923.016009}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}

{"timestamp":"2026-10-11T02:58:34.156Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a128e5-d82c-7e63-becc-f2eb9ce5eddb","call_id":"call_4199a97099154ab0b54b553c3e89606c","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"89aa36\",\"wall_time_seconds\":0.0000095,\"exit_code\":0,\"original_token_count\":3017,\"output\":\"Warning: truncated output (original token count: 3017)\\nTotal output lines: 295\\n\\n    DiscussionEvent,\\n    JudgeAssessment,\\n    JudgePacket,\\n    Limits,\\n    ProposalDecision,\\n    ProposalReviewInput,\\n    Rebuttal,\\n    ReviewInput,\\n    Scope,\\n    SemanticReview,\\n    Session,\\n    TopicOutcome,\\n    Work,\\n    now,\\n    uid,\\n)\\nfrom .sources import applicable, role_evidence\\nfrom .validation import semantic_result, validate_claim\\n\\n\\nfrom backend.moderator.errors import Conflict\\n\\n\\nclass Budget(ValueError):\\n    pass\\n\\n\\nasync def batch(*calls):\\n    tasks = [asyncio.create_task(c) for c in calls]\\n    try:\\n        return await asyncio.gather(*tasks)\\n    finally:\\n        for task in tasks:\\n            if not task.done():\\n                task.cancel()\\n        await asyncio.gather(*tasks, return_exceptions=True)\\n\\n\\nclass Engine:\\n    def __init__(self, catalog, store, adapters):\\n        self.catalog, self.store, self.adapters = catalog, store, adapters\\n        self.controller_url = os.getenv(\\\"MODERATOR_CONTROLLER_URL\\\", \\\"\\\").rstrip(\\\"/\\\")\\n        self.evidence = {e.id: e for e in catalog.evidence} if catalog else {}\\n        self.tasks = {}\\n        self.locks = defaultdict(asyncio.Lock)\\n        self.sessions = {s.id: s for s in store.sessions()}\\n        self.capabilities = {}\\n        self.deadlines = {}\\n        self.pending = {}\\n        if hasattr(adapters, \\\"bind_native\\\"):\\n            adapters.bind_native(self.resolve_native)\\n        self.on_commit = None\\n        saved = store.catalogs()\\n        self.catalogs = {c.snapshot_hash: c for c in saved}\\n        if catalog:\\n            self.catalogs[catalog.snapshot_hash] = catalog\\n            store.save_catalog(catalog)\\n        # Carry external intake forward onto the current supplied extraction,\\n        # preserving every historical catalog for already-confirmed sessions.\\n        latest_external = next(\\n            (\\n                c\\n                for c in reversed(saved)\\n                if any(x.provenance == \\\"external\\\" for x in c.sources)\\n            ),\\n            None,\\n        )\\n        if latest_external:\\n            if not catalog:\\n                self.catalog = latest_external\\n            else:\\n                for source in latest_external.sources:\\n                    # Reviewed specialist catalogs are rebuilt from their current\\n                    # source indexes; never resurrect expired records at restart.\\n                    if source.provenance == \\\"external\\\" and not source.id.startswith(\\\"specialist-source:\\\"):\\n                        self.catalog = extend_catalog(\\n                            self.catalog,\\n                            source,\\n                            [\\n                                e\\n                                for e in latest_external.evidence\\n                                if e.source_id == source.id\\n                            ],\\n                        )\\n                self.catalogs[self.catalog.snapshot_hash] = self.catalog\\n                store.save_catalog(self.catalog)\\n        self.evidence = {e.id: e for c in self.catalogs.values() for e in c.evidence}\\n        for s in self.sessions.values():\\n            existing_events = self.store.events(s.id)\\n            event_sequence = existing_events[-1].sequence if existing_events else 0\\n            if event_sequence > s.sequence:\\n                s.sequence = event_sequence\\n                s.status = \\\"paused\\\"\\n                s.generation += 1\\n                self.emit(s, \\\"recovery\\\", \\\"System\\\", \\\"Recovered an older snapshot behind the event log after concurrent backend access. Session paused; existing events retained.\\\")\\n            if s.status == \\\"running\\\":\\n                if s.work and s.work.stage_started_at:\\n                    elapsed = min(\\n                        s.limits.topic_seconds,\\n                        max(\\n                            0,\\n                            (\\n                                datetime.now(UTC)\\n                                - datetime.fromisoformat(s.work.stage_started_at)\\n                            ).total_seconds(),\\n                        ),\\n                    )\\n                    s.work.active_seconds += elapsed\\n                    s.active_seconds += elapsed\\n                    s.work.stage_started_at = None\\n                s.status = \\\"paused\\\"\\n                s.generation += 1\\n                self.emit(\\n                    s,\\n                    \\\"recovery\\\",\\n                    \\\"System\\\",\\n                    \\\"Server restarted. Recoverable session paused; in-flight reservations remain charged.\\\",\\n                )\\n\\n    def install_catalog(self, catalog):\\n        self.store.save_catalog(catalog)\\n        self.catalogs[catalog.snapshot_hash] = catalog\\n        self.evidence.update({e.id: e for e in catalog.evidence})\\n        self.catalog = catalog\\n\\n    def index(self, s):\\n        return {e.id: e for e in self.snapshot(s).evidence}\\n\\n    def get(self, sid):\\n        if sid not in self.sessions:\\n            raise KeyError(sid)\\n        return self.sessions[sid]\\n\\n    @contextmanager\\n    def atomic(self, s):\\n        if s.id in self.pending:\\n           …517 tokens truncated…asyncio.get_running_loop()\\n        app.state.engine.on_commit = lambda sid: loop.call_soon(\\n            app.state.presentations.reconcile, sid\\n        )\\n        for sid in app.state.engine.sessions:\\n            app.state.presentations.reconcile(sid)\\n        yield\\n        app.state.engine.on_commit = None\\n        await app.state.presentations.close()\\n        await app.state.engine.shutdown()\\n        if not engine:\\n            app.state.engine.store.close()\\n\\n    app = FastAPI(title=\\\"BMW moderator controller\\\", version=\\\"1.0.0\\\", lifespan=lifespan)\\n    start_lock = asyncio.Lock()\\n\\n    @app.post(\\\"/api/moderator/vehicle-debates\\\", status_code=201)\\n    async def start_vehicle(body: VehicleStart, request: Request):\\n        \\\"\\\"\\\"One explicit PM action covers every scoped, eligible Moderator topic.\\\"\\\"\\\"\\n        e = request.app.state.engine\\n        key = str(body.idempotency_key)\\n        fingerprint = json.dumps(body.scope.model_dump(), sort_keys=True)\\n        async with start_lock:\\n            saved = e.store.db.execute(\\\"SELECT fingerprint, session_id FROM vehicle_starts WHERE command_key=?\\\", (key,)).fetchone()\\n            if saved and saved[0] != fingerprint:\\n                raise Conflict(\\\"This start request already belongs to a different vehicle scope\\\")\\n            if saved:\\n                s = e.get(saved[1])\\n            else:\\n                # Deterministic source discovery is immediate; no model job is\\n                # needed just to show the PM that their debate has started.\\n                s = await e.create(body.scope, limits=Limits(session_seconds=21600, session_tokens=6000000), refine_agenda=False)\\n                with e.store.db:\\n                    e.store.db.execute(\\\"INSERT INTO vehicle_starts VALUES (?,?,?)\\\", (key, fingerprint, s.id))\\n            if s.status == \\\"awaiting_confirmation\\\":\\n                topics = [t.id for t in s.agenda.topics if t.eligible]\\n                if not topics:\\n                    raise HTTPException(422, \\\"No scoped evidence supports an agenda for this car. Choose a supported vehicle and market.\\\")\\n                s = await e.confirm(s.id, ConfirmAgenda(expected_version=s.agenda.version, selected_ids=topics))\\n            if s.status == \\\"ready\\\":\\n                s = await e.control(s.id, Control(action=\\\"start\\\", expected_revision=s.revision, idempotency_key=key))\\n            return s\\n\\n    from .discussion import install_discussion\\n    install_discussion(app)\\n    app.include_router(presentation_router)\\n\\n    @app.exception_handler(Conflict)\\n    async def conflict(_, error):\\n        return JSONResponse(status_code=409, content={\\\"detail\\\": str(error)})\\n\\n    @app.exception_handler(KeyError)\\n    async def missing(_, error):\\n        return JSONResponse(\\n            status_code=404,\\n            content={\\n                \\\"detail\\\": \\\"Session, topic, assumption or access capability not found\\\"\\n            usage={\\\"model_tokens\\\": w.tokens, \\\"active_seconds\\\": w.active_seconds},\\n        )\\n\\n    def close_topic(self, s, reason=None):\\n        with self.atomic(s):\\n            w = s.work\\n            for c in w.challenges:\\n                if c.status == \\\"open\\\":\\n                    c.status = \\\"unresolved\\\"\\n                    c.response = \\\"No completed rebuttal; incomplete evidence record.\\\"\\n            if reason is None:\\n                if w.budget_exhausted:\\n                    reason = \\\"budget_exhausted\\\"\\n                elif (\\n                    w.errors\\n                    or not w.assessment\\n                    or not w.alternatives\\n                    or any(\\n                        c.consequential and c.validation != \\\"supported\\\"\\n                        for c in w.claims\\n                    )\\n                    or not w.claims\\n                ):\\n                    reason = \\\"insufficient_evidence\\\"\\n                elif (\\n                    any(c.status != \\\"resolved\\\" for c in w.challenges)\\n                    or w.assessment.unresolved_issues\\n                ):\\n                    reason = \\\"unresolved_disagreement\\\"\\n                else:\\n                    reason = \\\"completed\\\"\\n            self.emit(\\n                s,\\n                \\\"closure\\\",\\n                \\\"moderator\\\",\\n                f\\\"Topic closed: {reason}. Queued for version-specific human review; no automatic approval.\\\",\\n                data={\\\"closure_reason\\\": reason},\\n            )\\n            packet = self.packet(s, reason).model_copy(deep=True)\\n            s.outcomes.append(\\n                TopicOutcome(\\n                    topic_id=w.brief.topic_id,\\n                    closure_reason=reason,\\n                    packet=packet,\\n                    assessment=w.assessment,\\n                )\\n103:class OpeningDraft(BaseModel):\\n231:class OllamaAdapters:\\n238:        self.native = None\\n242:        self.native = NativeSpecialists(self.settings, resolver)\\n250:    async def call(self, actor, operation, data, schema, max_output_tokens, request_id):\\n255:            if self.native is None:\\n257:            return await self.native.call(actor, operation, data)\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a128d6-e4d1-7942-a322-f4130d38a345","create_time":1791687514.156479}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}

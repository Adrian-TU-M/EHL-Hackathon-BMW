ent(id)}${snapshot ? `?source_snapshot=${snapshot}` : \\\"\\\"}`,\\n    ),\\n  external: (body: Record<string, unknown>) =>\\n    request<{ message: string; source_snapshot: string }>(\\n      \\\"/sources/external\\\",\\n      body,\\n    ),\\n  inventory: () =>\\n    request<{\\n      sources: SourceRecord[];\\n      warnings: string[];\\n      snapshot_hash: string;\\n    }>(\\\"/inventory\\\"),\\n  export: (id: string) => request<ModeratorExport>(`/sessions/${id}/export`),\\n  review: (\\n    s: ModeratorSession,\\n    tid: string,\\n    expected_version: number,\\n    status: string,\\n    rationale: string,\\n  ) =>\\n    request<ModeratorSession>(`/sessions/${s.id}/outcomes/${tid}/review`, {\\n      expected_version,\\n      status,\\n      rationale,\\n    }),\\n  reviewProposal: (\\n    s: ModeratorSession,\\n    topicId: string,\\n    proposalId: string,\\n    version: number,\\n    outcomeVersion: number,\\n    status: string,\\n    rationale: string,\\n  ) =>\\n    request<ModeratorSession>(\\n      `/sessions/${s.id}/outcomes/${topicId}/proposals/${encodeURIComponent(proposalId)}/review`,\\n      {\\n        expected_version: version,\\n        expected_outcome_version: outcomeVersion,\\n        status,\\n        rationale,\\n      },\\n    ),\\n  assumption: (\\n    s: ModeratorSession,\\n    id: string,\\n    expected_version: number,\\n    statement: string,\\n    status: string,\\n    rationale: string,\\n  ) =>\\n    request<ModeratorSession>(\\n      `/sessions/${s.id}/assumptions/${encodeURIComponent(id)}`,\\n      { expected_version, statement, status, rationale },\\n      \\\"PATCH\\\",\\n    ),\\n};\\nexport function downloadRecords(records: ModeratorExport) {\\n  const url = URL.createObjectURL(\\n    new Blob([JSON.stringify(records, null, 2)], { type: \\\"application/json\\\" }),\\n                    >\\n                      Jump to latest ↓\\n                    </button>\\n                  </footer>\\n                </section>\\n     
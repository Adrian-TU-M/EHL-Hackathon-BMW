ere.\\\"}\\n                        </h3>\\n                        <p>\\n                          Actual statements appear when each turn is ready. The\\n                          stage above updates while local Qwen works.\\n                        </p>\\n                      </div>\\n                    )}\\n                    {active && (\\n                      <div className=\\\"vc-working\\\" role=\\\"status\\\">\\n                        <i />\\n                        <span>\\n                          {stages[s.work?.stage || \\\"\\\"] ||\\n                            \\\"Moderator preparing the next topic\\\"}\\n                          …\\n                        </span>\\n                      </div>\\n                    )}\\n                  </div>\\n                  <footer className=\\\"vc-transcript-footer\\\">\\n                    <small>\\n                      Saved automatically · ordered from first to latest\\n                    </small>\\n                    <button\\n                      className=\\\"text-link\\\"\\n                      onClick={() => {\\n                        follow.current = true;\\n                        feed.current?.scrollTo({\\n                          top: feed.current.scrollHeight,\\n                          behavior: \\\"smooth\\\",\\n                        });\\n                      }}\\n                    >\\nimport type { Scope } from \\\"../types\\\";\\nimport type {\\n  ModeratorControl,\\n  ModeratorExport,\\n  ModeratorSession,\\n  SourceEvidence,\\n  SourceRecord,\\n} from \\\"./contracts\\\";\\nconst root = \\\"/api/moderator\\\";\\nexport interface ModeratorSessionSummary {\\n  id: string;\\n  status: ModeratorSession[\\\"status\\\"];\\n  scope: Pick<Scope, \\\"vehicle\\\" | \\\"market\\\" | \\\"powertrain\\\" | \\\"horizon\\\">;\\n  topic_label: string | null;\\n  stage: string | null;\\n  sequence: number;\\n  outcome_count: number;\\n  selected_count: number;\\n  mode: ModeratorSessio
ent(\\n            **draft.model_dump(), id=str(uuid4()), created_at=timestamp(),\\n            weights=request.weights, constraints=request.constraints,\\n            ranked_feature_ids=[f.feature_id for f in sorted(draft.features,\\n                key=lambda f: (-(f.priority if f.priority is not None else -1), f.feature_id))],\\n            next_action=action, execution=self.ai.execution, input_digest=digest(request),\\n            model=getattr(self.ai, \\\"model\\\", None), provider=getattr(self.ai, \\\"provider\\\", None),\\n        )\\n\\nclass CriterionAssessment(Model):\\n    value: Rating | None\\n    argument_ids: list[str] = Field(default_factory=list)\\n    rationale: Text\\n\\n\\nclass FeatureAssessment(Model):\\n    feature_id: Text\\n    feature_version: Annotated[int, Field(ge=1)]\\n    recommendation: Literal[\\\"recommend\\\", \\\"revise\\\", \\\"defer\\\", \\\"do_not_recommend\\\"]\\n    rationale: Text\\n    criteria: dict[Criterion, CriterionAssessment]\\n    priority: int | None = None\\n    coverage: int = 0\\n    evidence_strength: Literal[\\\"Illustrative\\\", \\\"Limited\\\", \\\"Moderate\\\", \\\"Strong\\\", \\\"Unknown\\\"]\\n    benefits: list[str] = Field(default_factory=list)\\n    drawbacks: list[str] = Field(default_factory=list)\\n    risks: list[str] = Field(default_factory=list)\\n    assumptions: list[str] = Field(default_factory=list)\\n    uncertainties: list[str] = Field(default_factory=list)\\n    alternatives: list[str] = Field(default_factory=list)\\n    proposed_description: str | None = None\\n    consequential_uncertainty: bool = False\\n\\n\\nclass PriorityProposal(Model):\\n    weights: Weights\\n    constraints: list[str] = Field(default_factory=list)\\n    rationale: Text\\n\\n\\nclass DraftAssessment(Model):\\n    arguments: list[ArgumentAssessment]\\n    features: list[FeatureAssessment]\\n    clarification_requests: list[str] = Field(default_factory=list)\\n    proposed_priorities: PriorityProposal | None = None\\n\\n\\nclass JudgeAssessment(DraftAssessment):\\n    id: str\\n    created_at: str\\n    weights: Weights\\n    constraints: list[str]\\n    ranked_feature_ids: list[str]\\n    next_action: Literal[\\\"continue\\\", \\\"request_clarification\\\", \\\"pause_for_pm\\\"]\\n    execution: Literal[\\\"live\\\", \\\"demo\\\"]\\n    input_digest: str\\n    model: str | None = None\\n    provider: str | None = None\\n\\n\\nclass CouncilEvent(Model):\\n    sequence: int\\n    id: str\\n            validate_claim(\\n                c,\\n                self.index(s),\\n                s.agenda.scope,\\n                allowed_ids,\\n                {a.id for a in s.assumptions},\\n            )\\n            if self.adapters.mode == \\\"ollama\\\" and c.validation == \\\"unverified\\\":\\n                from .local import is_exact_source_claim\\n                if is_exact_source_claim(c, self.index(s), w.brief.model_dump()):\\n                    c.validation = \\\"supported\\\"\\n                    c.semantic_check = \\\"exact_source_quote\\\"\\n        for a in position.alternatives:\\n            a.id = prefix + a.id\\n            a.assumption_ids = [aids.get(i, i) for i in a.assumption_ids]\\n            if not set(a.assumption_ids).issubset({x.id for x in s.assumptions}):\\n                w.errors.append(f\\\"Alternative {a.id} references an unknown assumption\\\")\\n        if any(i not in allowed_ids for i in position.counterevidence_ids):\\n            position.counterevidence_ids = [\\n                i for i in position.counterevidence_ids if i in allowed_ids\\n            ]\\n            w.errors.append(f\\\"Unauthorized counterevidence rejected from {role}\\\")\\n        w.positions.append(position)\\n        w.claims.extend(position.claims)\\n        w.alternatives.extend(position.alternatives)\\n        self.emit(\\n            s,\\n            \\\"perspectives\\\",\\n            role,\\n            position.summary,\\n            [i for c in position.claim
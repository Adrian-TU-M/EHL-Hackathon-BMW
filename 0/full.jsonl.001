{"timestamp":"2026-10-11T02:58:40.433Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a128e5-f0b1-7831-b090-fed4b3fc3865","call_id":"call_f0de676310144d8581095f6199787d08","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"eac331\",\"wall_time_seconds\":0.000007958,\"exit_code\":1,\"original_token_count\":1576,\"output\":\"    def emit(\\n        self, s, stage, actor, statement, evidence_ids=None, data=None, command=None\\n    ):\\n        if s.id not in self.pending:\\n            with self.atomic(s):\\n                return self.emit(\\n                    s, stage, actor, statement, evidence_ids, data, command\\n                )\\n        s.sequence += 1\\n        event = DiscussionEvent(\\n            id=f\\\"{s.id}:{s.sequence}\\\",\\n            session_id=s.id,\\n            run_id=s.run_id,\\n            topic_id=s.work.brief.topic_id if s.work else None,\\n            sequence=s.sequence,\\n            stage=stage,\\n            actor=actor,\\n            statement=statement,\\n            evidence_ids=evidence_ids or [],\\n            assumption_versions={a.id: a.version for a in s.assumptions},\\n            data=data or {},\\n        )\\n        self.pending[s.id][\\\"events\\\"].append(event)\\n        if command:\\n            self.pending[s.id][\\\"command\\\"] = command\\n        return event\\n\\n    def check_snapshot(self, s):\\n            raise ValueError(\\\"An unknown scoring input cannot carry an invented value\\\")\\n        return self\\n\\n\\nclass JudgeProposal(Model):\\n    id: str\\n    version: int = Field(default=1, ge=1)\\n    title: str = Field(min_length=1)\\n    description: str = Field(min_length=1)\\n    evidence_ids: list[str] = Field(default_factory=list)\\n    claim_ids: list[str] = Field(default_factory=list)\\n    assumption_ids: list[str] = Field(default_factory=list)\\n\\n\\nclass JudgeAssessment(Model):\\n    summary: str\\n    unresolved_issues: list[str] = Field(default_factory=list)\\n    clarification: Clarification | None = None\\n    evidence_ids: list[str] = Field(default_factory=list)\\n    scoring_inputs: list[ScoringInput] = Field(default_factory=list)\\n    proposals: list[JudgeProposal] = Field(default_factory=list)\\n    native_assessment: dict[str, Any] | None = None\\n    native_request: dict[str, Any] | None = None\\n\\n\\nclass TopicBrief(Model):\\n    topic_id: str\\n    question: str\\n    scope: Scope\\n    objective: str\\n    equipment_baseline: list[str]\\n    coverage: dict[str, int]\\n    limitations: list[str]\\n    change_question: str = (\\n        \\\"Which supplied evidence would change the preferred alternative?\\\"\\n    )\\n\\n\\nclass DiscussionEvent(Model):\\n    id: str\\n    session_id: str\\nfrom __future__ import annotations\\n\\nimport asyncio\\nimport os\\nimport json\\nfrom uuid import UUID\\nfrom contextlib import asynccontextmanager\\nfrom pathlib import Path\\n\\nfrom fastapi import FastAPI, Header, HTTPException, Request\\nfrom fastapi.responses import FileResponse, JSONResponse, StreamingResponse\\nfrom pydantic import Field\\nfrom backend.config import Settings\\n\\nfrom backend.presentation.api import router as presentation_router\\nfrom backend.presentation.service import PresentationService\\nfrom backend.presentation.storage import PresentationStore\\n\\nfrom .adapters import DeterministicAdapters, HttpAdapters\\nfrom .local import OllamaAdapters\\nfrom .catalog_bridge import specialist_catalog\\nfrom .engine import Conflict, Engine\\nfrom .external import ExternalInput, extend_catalog, fetch_source\\nfrom .models import (\\n    AssumptionChange,\\n    ConfirmAgenda,\\n    Control,\\n    Limits,\\n    Model,\\n    ProposalReviewInput,\\n    ReviewInput,\\n    Scope,\\n)\\nfrom .sources import load_catalog\\nfrom .storage import Store\\n\\nROOT = Path(__file__).resolve().parents[2]\\n\\n\\nclass PrepareInput(Model):\\n    scope: Scope\\n    parent_session_id: str | None = None\\n    limits: Limits = Field(default_factory=Limits)\\n\\n\\nclass RetrievalInput(Model):\\n    ids: list[str] = Field(max_length=100)\\n\\n\\nclass VoiceInput(Model):\\n    assessment_id: str\\n\\n\\nclass VehicleStart(Model):\\n    scope: Scope\\nclass OllamaAdapters:\\n    mode = \\\"ollama\\\"\\n    native_implementations = True\\n\\n    def __init__(self, settings: Settings | None = None, llm=None):\\n        self.settings = settings or Settings.from_env()\\n        self.llm = llm or OllamaClient(replace(self.settings, ollama_timeout_seconds=max(240, self.settings.ollama_timeout_seconds)))\\n        self.native = None\\n\\n    def bind_native(self, resolver):\\n        from .native import NativeSpecialists\\n        self.native = NativeSpecialists(self.settings, resolver)\\n\\n    def missing(self):\\n        return []  # Runtime connectivity is checked by health; never substitute fixtures.\\n\\n    async def close(self):\\n        pass\\n\\n    async def call(self, actor, operation, data, schema, max_output_tokens, request_id):\\n        if actor == \\\"judge\\\" and operation == \\\"assessment\\\":\\n            from .judge_bridge import assess_packet\\n            return await assess_packet(data, self.settings)\\n        if actor in {\\\"customer\\\", \\\"market\\\", \\\"competitor\\\"} and operation in {\\\"perspective\\\", \\\"challenge\\\", \\\"rebuttal\\\", \\\"clarification\\\"} and data.get(\\\"participant_runtime\\\") == \\\"native\\\":\\n            if self.native is None:\\n                raise RuntimeError(\\\"Native specialist resolver is not connected\\\")\\n            return await self.native.call(actor, operation, data)\\n        if operation not in TASKS:\\n            raise ValueError(f\\\"Unsupported local operation: {operation}\\\")\\n        output_schema = constrain_schema(schema, actor, operation, data)\\n        native_review = operation == \\\"semantic_check\\\" and data.get(\\\"participant_runtime\\\") == \\\"native\\\"\\n        if native_review:\\n            ids = [c[\\\"id\\\"] for c in data.get(\\\"claims\\\", [])]\\n            check = {\\\"type\\\": \\\"object\\\", \\\"properties\\\": {\\\"supported\\\": {\\\"type\\\": \\\"boolean\\\"}, \\\"reason\\\": {\\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 240}}, \\\"required\\\": [\\\"supported\\\", \\\"reason\\\"], \\\"additionalProperties\\\": False}\\n            output_schema = {\\\"type\\\": \\\"object\\\", \\\"properties\\\": {\\\"checks\\\": {\\\"type\\\": \\\"object\\\", \\\"properties\\\": {key: check for key in ids}, \\\"required\\\": ids, \\\"additionalProperties\\\": False}}, \\\"required\\\": [\\\"checks\\\"], \\\"additionalProperties\\\": False}\\n        generation_data = data\\n        facts = {}\\n        if operation == \\\"perspective\\\":\\n            facts = source_facts(actor, data)\\n            output_schema = opening_schema(facts)\\n            generation_data = {**data, \\\"source_choices\\\": [\\n                {\\\"evidence_id\\\": eid, \\\"exact_statement\\\": fact[\\\"statement\\\"]} for eid, fact in facts.items()\\n            ]}\\n        system = specialist_prompt(actor) + \\\"\\\\n\\\" + POLICY + \\\"\\\\n\\\" + TASKS[operation] + \\\"\\\"\\\"\\nThe moderator controller's provided response schema is authoritative for this operation;\\nsed: backend/moderator/store.py: No such file or directory\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a128d6-e4d1-7942-a322-f4130d38a345","create_time":1791687520.433888}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}

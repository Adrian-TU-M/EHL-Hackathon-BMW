{"timestamp":"2026-10-11T05:23:51.660Z","type":"token_usage_record","payload":{"thread_id":"01a1261a-2a92-7960-ad84-d63846639755","turn_id":"01a12915-f14a-7292-888b-5b2b4a685e60","session_id":"01a1261a-2a92-7960-ad84-d63846639755","root_turn_id":"01a12915-f14a-7292-888b-5b2b4a685e60","response_id":"resp_0fec30a92d8d98f6016acb1d5d4f908191a1675d2195196e57","usage":{"input_tokens":71919,"cached_input_tokens":70528,"cache_write_input_tokens":0,"output_tokens":180,"reasoning_output_tokens":118,"total_tokens":72099},"turn_token_usage":{"input_tokens":37354717,"cached_input_tokens":36928256,"cache_write_input_tokens":0,"output_tokens":132112,"reasoning_output_tokens":68799,"total_tokens":37486829},"thread_token_usage":{"input_tokens":211731255,"cached_input_tokens":206699008,"cache_write_input_tokens":0,"output_tokens":937913,"reasoning_output_tokens":277155,"total_tokens":212669168}}}
{"timestamp":"2026-10-11T05:23:51.846Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a1296a-dda6-75f2-8053-11218b44f1e7","call_id":"call_988f8bb370494f2ba6a205944fdfe514","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"cc8918\",\"wall_time_seconds\":0.000006583,\"exit_code\":0,\"original_token_count\":3130,\"output\":\"import { useState } from \\\"react\\\";\\nimport { Check, Play, Search } from \\\"lucide-react\\\";\\nimport { Button, Modal } from \\\"../ui/Primitives\\\";\\nimport type { ModeratorSession } from \\\"../../lib/council/contracts\\\";\\n\\nexport function AgendaDialog({\\n  session,\\n  busy,\\n  error,\\n  onClose,\\n  onStart,\\n}: {\\n  session?: ModeratorSession;\\n  busy: boolean;\\n  error?: string;\\n  onClose: () => void;\\n  onStart: (ids: string[]) => void;\\n}) {\\n  const [selected, setSelected] = useState<string[]>(\\n    () => session?.agenda.selected_ids || [],\\n  );\\n  const [query, setQuery] = useState(\\\"\\\");\\n  const frozen = !!session?.agenda.confirmed_at;\\n  const topics =\\n    session?.agenda.topics.filter(\\n      (t) =>\\n        t.eligible && (!frozen || session.agenda.selected_ids.includes(t.id)),\\n    ) || [];\\n  const visible = topics.filter((t) =>\\n    `${t.label} ${t.area}`.toLowerCase().includes(query.toLowerCase()),\\n  );\\n  const chosen = frozen ? session!.agenda.selected_ids : selected;\\n  return (\\n    <Modal\\n      title={frozen ? \\\"Your debate agenda\\\" : \\\"What should we explore?\\\"}\\n      onClose={onClose}\\n      wide\\n    >\\n      <div className=\\\"council-agenda-dialog\\\">\\n        <p className=\\\"agenda-intro\\\">\\n          {session\\n            ? `${session.agenda.scope.vehicle} · ${session.agenda.scope.market}`\\n            : \\\"Reading the car’s evidence…\\\"}\\n        </p>\\n        <p>\\n          {frozen\\n            ? \\\"The council follows this confirmed selection. Start a new council to choose a different agenda.\\\"\\n            : \\\"Moderator has found these evidence-backed topics. Choose what matters; the agents will debate each one before Jury drafts a requirement.\\\"}\\n        </p>\\n        {error && (\\n          <p role=\\\"alert\\\" className=\\\"vc-error\\\">\\n            {error}\\n          </p>\\n        )}\\n        {session && (\\n          <>\\n            <div className=\\\"agenda-toolbar\\\">\\n              <label>\\n                <Search size={16} />\\n                <input\\n                  aria-label=\\\"Find a topic\\\"\\n                  placeholder=\\\"Find a topic\\\"\\n                  value={query}\\n                  onChange={(e) => setQuery(e.target.value)}\\n                />\\n              </label>\\n              <span>{chosen.length} selected</span>\\n            </div>\\n            {!frozen && (\\n              <div className=\\\"agenda-shortcuts\\\">\\n                <button\\n                  className=\\\"text-link\\\"\\n                  onClick={() => setSelected(topics.map((t) => t.id))}\\n                >\\n                  Select all {topics.length}\\n                </button>\\n                <button className=\\\"text-link\\\" onClick={() => setSelected([])}>\\n                  Clear selection\\n                </button>\\n              </div>\\n            )}\\n            <div className=\\\"agenda-topic-list\\\">\\n              {visible.map((t) => (\\n                <label\\n                  key={t.id}\\n                  className={`agenda-topic ${chosen.includes(t.id) ? \\\"selected\\\" : \\\"\\\"}`}\\n                >\\n                  <input\\n                    type=\\\"checkbox\\\"\\n                    checked={chosen.includes(t.id)}\\n                    disabled={frozen || busy}\\n                    onChange={(e) =>\\n                      setSelected((previous) =>\\n                        e.target.checked\\n                          ? [...previous, t.id]\\n                          : previous.filter((id) => id !== t.id),\\n                      )\\n                    }\\n                  />\\n                  <div>\\n                    <strong>{t.label}</strong>\\n                    <p>{t.question}</p>\\n                    <small>\\n                      {t.evidence_ids.length} source references\\n                      {t.exploratory ? \\\" · exploratory\\\" : \\\"\\\"}\\n                    </small>\\n                  </div>\\n                  {frozen &&\\n                    session.outcomes.some((o) => o.topic_id === t.id) && (\\n                      <Check size={18} />\\n                    )}\\n                </label>\\n              ))}\\n            </div>\\n            <footer className=\\\"agenda-dialog-footer\\\">\\n              <small>\\n                {frozen\\n                  ? \\\"Sources and decisions remain attached to this agenda.\\\"\\n                  : \\\"Each topic includes proposals, challenges, responses and a Jury assessment. Local Qwen can take several minutes per topic.\\\"}\\n              </small>\\n              {frozen ? (\\n                <Button onClick={onClose}>Back to council</Button>\\n              ) : (\\n                <Button\\n                  disabled={busy || !chosen.length}\\n                  onClick={() => onStart(chosen)}\\n                >\\n                  <Play size={15} />\\n                  {busy\\n                    ? \\\"Starting…\\\"\\n                    : `Start debate · ${chosen.length} topic${chosen.length === 1 ? \\\"\\\" : \\\"s\\\"}`}\\n                </Button>\\n              )}\\n            </footer>\\n          </>\\n        )}\\n      </div>\\n    </Modal>\\n  );\\n}\\nimport asyncio\\nimport hashlib\\nimport json\\nimport logging\\nimport re\\nfrom datetime import datetime, timezone\\nfrom uuid import uuid4\\nfrom .adapters import AIAdapter\\nfrom .models import JudgeAssessment, JudgeRequest\\nfrom .scoring import CRITERIA, influence, score\\n\\n\\ndef timestamp() -> str:\\n    return datetime.now(timezone.utc).isoformat()\\n\\n\\ndef digest(request: JudgeRequest) -> str:\\n    payload = request.model_dump(mode=\\\"json\\\")\\n    # Preserve digests for historical production packets saved before concept mode.\\n    if payload.get(\\\"decision_stage\\\") == \\\"production\\\":\\n        payload.pop(\\\"decision_stage\\\", None)\\n    return hashlib.sha256(json.dumps(payload, sort_keys=True).encode()).hexdigest()\\n\\n\\nclass JudgeService:\\n    def __init__(self, ai: AIAdapter):\\n        self.ai = ai\\n        self._assessment_lock = asyncio.Lock()\\n\\n    async def assess(self, request: JudgeRequest) -> JudgeAssessment:\\n        # Standalone Judge endpoints share one provider. Keep its repair prompt\\n        # and usage counters isolated when two PM requests arrive together.\\n        async with self._assessment_lock:\\n            return await self._assess_bounded(request)\\n\\n    async def _assess_bounded(self, request: JudgeRequest) -> JudgeAssessment:\\n        if hasattr(self.ai, \\\"last_usage\\\"):\\n            # One assessment may include a repair; both calls consume the same\\n            # moderator budget, while a subsequent assessment starts afresh.\\n            self.ai.last_usage = {\\\"input_tokens\\\": 0, \\\"output_tokens\\\": 0}\\n        try:\\n            return await self._assess(request)\\n        except ValueError as exc:\\n            if not hasattr(self.ai, \\\"validation_error\\\"):\\n                raise\\n            logging.getLogger(\\\"uvicorn.error\\\").warning(\\\"Judge repairing rejected assessment: %s\\\", str(exc)[:700])\\n            self.ai.validation_error = str(exc)[:700]\\n            try:\\n                return await self._assess(request)\\n            finally:\\n                self.ai.validation_error = \\\"\\\"\\n\\n    async def _assess(self, request: JudgeRequest) -> JudgeAssessment:\\n        draft = await asyncio.wait_for(self.ai.evaluate(request), timeout=getattr(self.ai, \\\"call_timeout_seconds\\\", 65))\\n        args = {a.id: a for a in request.arguments}\\n        evidence = {e.id: e for e in request.evidence}\\n        features = {f.id: f for f in request.features}\\n        if len(draft.arguments) != len(args) or {a.argument_id for a in draft.arguments} != set(args):\\n            raise ValueError(\\\"Model must assess every argument exactly once\\\")\\n        if len(draft.features) != len(features) or {f.feature_id for f in draft.features} != set(features):\\n            raise ValueError(\\\"Model must assess every feature exactly once\\\")\\n        assessed = {a.argument_id: a for a in draft.arguments}\\n        ungrounded = set()\\n        for result in draft.arguments:\\n            original = args[result.argument_id]\\n            active = []\\n            for citation in result.citations:\\n                source = evidence.get(citation.evidence_id)\\n                if not source or source.id not in original.evidence_ids:\\n                    allowed = [eid for eid in original.evidence_ids if eid in evidence and not evidence[eid].exclusion_reason]\\n                    raise ValueError(\\n                        \\\"Citation must reference evidence attached to its argument: \\\"\\n                        f\\\"argument_id={original.id[:180]!r}, evidence_id={citation.evidence_id[:180]!r}; \\\"\\n                        f\\\"allowed evidence_ids={[eid[:180] for eid in allowed[:8]]!r}. \\\"\\n                        \\\"Use only an allowed source with an exact quote, or no citations and support null.\\\"\\n                    )\\n                if source.exclusion_reason or citation.quote not in source.passage:\\n                    raise ValueError(\\\"Citation passage is invalid or excluded\\\")\\n                active.append(source)\\n            if any(\\\"scale\\\" in e.passage.lower() and \\\"undocumented\\\" in e.passage.lower() for e in active):\\n                if re.search(r\\\"\\\\b(?:low|high|poor|good)\\\\b\\\", result.explanation, re.I) and re.search(r\\\"satisf|rating|mean|score\\\", result.explanation, re.I):\\n                    raise ValueError(\\\"An undocumented study scale cannot establish high/low satisfaction or good/bad ratings. Assess only the literal source statement and explain this limitation.\\\")\\n            missing = [eid for eid in original.evidence_ids if eid not in evidence]\\n            result.issues.extend(f\\\"Missing evidence: {eid}\\\" for eid in missing)\\n            if result.support and not active:\\n                # An uncited perspective may be a useful hypothesis. Its lack of\\n                # factual support is an assessment outcome, not a service error.\\n                # Fabricated quotations still fail the strict checks above.\\n                result.support = None\\n                result.verdict = \\\"unknown\\\"\\n                result.issues.append(\\\"No validated passage citation; factual support remains unknown.\\\")\\n                ungrounded.add(result.argument_id)\\n            if result.verdict in (\\\"unsupported\\\", \\\"contradicted\\\"):\\n                result.support = 0\\n            elif result.verdict == \\\"unknown\\\":\\n                result.support = None\\n                ungrounded.add(result.argument_id)\\n            if active and all(e.provenance == \\\"synthetic\\\" for e in active):\\n                result.support = min(result.support, 1) if result.support is not None else None\\n            result.influence = influence(result.support, result.relevance)\\n            # Shared observations remain explicit, never extra independent votes.\\n            for other in request.arguments:\\n                if other.id == original.id:\\n                    continue\\n                source_keys = {evidence[e].observation_id or\\n                               f\\\"{evidence[e].source}:{evidence[e].location}:{evidence[e].passage}\\\"\\n                               for e in original.evidence_ids if e in evidence}\\n                other_keys = {evidence[e].observation_id or\\n                              f\\\"{evidence[e].source}:{evidence[e].location}:{evidence[e].passage}\\\"\\n                              for e in other.evidence_ids if e in evidence}\\n                if original.statement.casefold() == other.statement.casefold() or source_keys & other_keys:\\n                    result.issues.append(f\\\"Shared/repeated support with {other.id}; not independent corroboration\\\")\\n        for result in draft.features:\\n            feature = features[result.feature_id]\\n            if result.feature_version != feature.version or set(result.criteria) != set(CRITERIA):\\n                raise ValueError(\\\"Feature version or criterion keys do not match\\\")\\n            for criterion in result.criteria.values():\\n                for aid in criterion.argument_ids:\\n                    if aid not in args or feature.id not in args[aid].feature_ids:\\n                        raise ValueError(\\\"Criterion arguments must belong to this feature\\\")\\n                if criterion.value is not None and not any(\\n                    assessed[aid].support is not None and assessed[aid].support > 0\\n                    for aid in criterion.argument_ids\\n                ):\\n                    if set(criterion.argument_ids) & ungrounded:\\n                        criterion.value = None\\n                        criterion.rationale = \\\"Unknown: the proposed supporting argument has no validated citation. \\\" + criterion.rationale\\n                        result.consequential_uncertainty = True\\n                        result.uncertainties.append(\\\"A proposed criterion rating was left unknown because its supporting argument had no validated citation.\\\")\\n                    else:\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a12915-f14a-7292-888b-5b2b4a685e60","create_time":1791696231.84602}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}

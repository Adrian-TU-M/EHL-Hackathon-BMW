# Export these in your shell or pass --env-file with dotenv support installed.
MODERATOR_ADAPTER=http
# MODERATOR_DATA_DIR=/absolute/path/to/private-data
# Optional absolute controller address reachable by the agent services.
# MODERATOR_CONTROLLER_URL=http://127.0.0.1:8000
CUSTOMER_AGENT_URL=http://127.0.0.1:8101/respond
MARKET_AGENT_URL=http://127.0.0.1:8102/respond
COMPETITOR_AGENT_URL=http://127.0.0.1:8103/respond
MODERATOR_AGENT_URL=http://127.0.0.1:8104/respond
JUDGE_AGENT_URL=http://127.0.0.1:8105/respond
# Optional per-service bearer credentials; never expose to Vite.
# CUSTOMER_AGENT_TOKEN=
# MARKET_AGENT_TOKEN=
# COMPETITOR_AGENT_TOKEN=
# MODERATOR_AGENT_TOKEN=
# JUDGE_AGENT_TOKEN=

# Presentation writer uses local Ollama, independently of council services.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# PRESENTATION_DATA_DIR=/absolute/path/to/private-runtime-data
# PRESENTATION_ONLY=1

# Optional local configuration. Copy to backend/.env (ignored by Git).
# All five agents use this one Ollama model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=180
BMW_DATA_DIR=private-data/inputs
FRONTEND_ORIGIN=http://127.0.0.1:5173
EVIDENCE_INDEX=backend/data/evidence.json
MARKET_INDEX=backend/data/market.json
AGENT_RUNS_DIR=backend/data/runs
AGENT_TIMEOUT_SECONDS=360
MODERATOR_ADAPTER=ollama
# Require Text to Speech + Speech to Text endpoint permissions only.
# Narration/transcription API only; never expose this secret to Vite.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Original continuous ElevenLabs conversational agent (public ID supplied by its owner).
ELEVENLABS_AGENT_ID=
# Only enable after the owner configures a blocking ask_jury(question) client tool.
ELEVENLABS_JURY_TOOL_ENABLED=0

# Presentation writer shares the local Qwen model above.
# PRESENTATION_DATA_DIR=/absolute/path/to/private-runtime-data
# PRESENTATION_ONLY=1

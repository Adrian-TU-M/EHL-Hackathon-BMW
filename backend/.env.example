# Explicitly enable fixtures only for local integration.
JUDGE_DEMO_MODE=0
JUDGE_INPUT_MODE=context
# Default: local Qwen through Ollama. Install Ollama, then:
# ollama pull qwen3:4b-instruct
# ollama serve  (or open the Ollama desktop app)
JUDGE_BASE_URL=http://127.0.0.1:11434
JUDGE_MODEL=qwen3:4b-instruct
JUDGE_API_FORMAT=ollama
# Local inference can take longer, especially without a GPU.
JUDGE_MODEL_TIMEOUT_SECONDS=300
# For an existing vLLM/other OpenAI-compatible Qwen server instead:
# JUDGE_BASE_URL=http://127.0.0.1:9000/v1
# JUDGE_MODEL=your-served-qwen-model
# JUDGE_API_FORMAT=chat
# JUDGE_RESPONSE_FORMAT=json_object
# JUDGE_API_KEY=only-if-your-local-server-requires-one
# Keep credentials server-side. Never use VITE_ variables for API keys.
# These are team gateway contracts, not provider-specific URLs.
JUDGE_MODEL_URL=
JUDGE_MODEL_TOKEN=
JUDGE_MODERATOR_URL=
JUDGE_MODERATOR_TOKEN=

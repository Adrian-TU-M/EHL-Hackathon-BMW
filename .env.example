# Local LLM for the Customer Agent (Ollama).
# Setup: brew install ollama && brew services start ollama && ollama pull qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Directory with the supplied customer datasets (kept outside the repo; never commit them).
BMW_DATA_DIR=~/DataSetsfromBMW

# Public Conversational AI agent ID for the BMW NEXT Judge (never put API keys here).
VITE_ELEVENLABS_AGENT_ID=

# Separate presentation editing/coaching agent (public ID only).
VITE_ELEVENLABS_PRESENTATION_AGENT_ID=
